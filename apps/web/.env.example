# Copie para .env.local (não versionado). Só variáveis VITE_* chegam ao navegador: nunca coloque segredos aqui.

# API simulada (MSW). true = sem backend; false = usa /api/v1 (proxy do Vite → `wrangler dev` da API, porta 8787).
# Padrão sem a variável: true em `pnpm dev`, false em `pnpm build`.
VITE_API_MOCK=true

# Chave PÚBLICA do Turnstile (site key). Em dev, a chave de teste da Cloudflare é 1x00000000000000000000AA.
# Sem ela, o modo simulado mostra uma caixa "Não sou um robô (teste)" e o modo real avisa que a verificação está indisponível.
VITE_TURNSTILE_SITE_KEY=
