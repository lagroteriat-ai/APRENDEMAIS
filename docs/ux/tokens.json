{
  "$meta": {
    "nome": "Aprende+ design tokens",
    "versao": "1.0",
    "dono": "UX",
    "consumidores": ["FE (packages/ui)"],
    "fonte": "Paleta derivada das variáveis :root de style.css (--navy, --blue, --yellow, --text, --muted, --line, --bg). Cores semânticas, sombras e escalas são novas.",
    "convencao": "Valor final em 'value'. FE gera CSS variables com prefixo --am- (ex.: color.brand.navy -> --am-color-brand-navy). Nomes estáveis; mudança de valor = patch, renomear/remover = nova versão + AVISO.",
    "unidades": "px no JSON; FE converte para rem (1rem = 16px) em tipografia e espaçamento.",
    "tema": "Somente claro na v0.1. Modo escuro fica para versão futura."
  },

  "color": {
    "brand": {
      "navy":   { "value": "#062b51", "origem": "--navy",   "uso": "Títulos, texto sobre amarelo, fundos escuros (cabeçalho do hero)." },
      "blue":   { "value": "#0a55b7", "origem": "--blue",   "uso": "Ação primária, links, foco." },
      "yellow": { "value": "#f7b51b", "origem": "--yellow", "uso": "Destaque e recompensa. Só como FUNDO, com texto navy. Nunca como texto ou ícone sobre branco (1.81:1)." }
    },
    "neutral": {
      "text":        { "value": "#102b53", "origem": "--text",  "uso": "Texto principal." },
      "muted":       { "value": "#4d6382", "origem": "--muted", "uso": "Texto secundário, ajuda, placeholder." },
      "line":        { "value": "#e4eaf2", "origem": "--line",  "uso": "Divisores decorativos. NÃO usar como borda de campo (1.2:1)." },
      "border":      { "value": "#7b8aa0", "novo": true,         "uso": "Borda de campo, checkbox e componentes interativos (3:1, WCAG 1.4.11)." },
      "bg":          { "value": "#ffffff", "origem": "--bg",    "uso": "Fundo da página." },
      "surface":     { "value": "#f4f7fb", "novo": true,         "uso": "Fundo de cartões e faixas." },
      "white":       { "value": "#ffffff",                       "uso": "Texto sobre blue, navy e success." }
    },
    "primary": {
      "default": { "value": "#0a55b7", "uso": "Botão primário (fundo), texto branco." },
      "hover":   { "value": "#084a9f", "novo": true },
      "active":  { "value": "#063e85", "novo": true },
      "tint":    { "value": "#eaf2fd", "novo": true, "uso": "Fundo de item selecionado/info." }
    },
    "accent": {
      "default": { "value": "#f7b51b", "uso": "Botão de destaque/recompensa (fundo), texto navy." },
      "hover":   { "value": "#e8a606", "novo": true },
      "tint":    { "value": "#fff6dc", "novo": true, "uso": "Fundo de aviso." },
      "light":   { "value": "#ffd466", "novo": true, "uso": "Fundo de selo/conquista (texto navy 10.1:1)." }
    },
    "feedback": {
      "success": { "fg": "#146c3f", "bg": "#e8f5ee", "solid": "#1b7a4b", "novo": true },
      "error":   { "fg": "#9f1f18", "bg": "#fdecea", "solid": "#b3261e", "novo": true },
      "warning": { "fg": "#7a4f00", "bg": "#fff6dc", "solid": "#7a4f00", "novo": true },
      "info":    { "fg": "#0a55b7", "bg": "#eaf2fd", "solid": "#0a55b7" }
    },
    "focus": {
      "ring":         { "value": "#0a55b7", "uso": "Anel de foco sobre fundos claros." },
      "ringOnDark":   { "value": "#f7b51b", "uso": "Anel de foco sobre navy/blue." },
      "width": 3,
      "offset": 2,
      "regra": "Foco sempre visível, nunca 'outline: none' sem substituto. Anel com ≥3:1 contra o fundo e contra o componente (WCAG 2.4.11/2.4.13)."
    },
    "overlay": { "value": "rgba(6, 43, 81, 0.55)", "novo": true, "uso": "Fundo do modal." }
  },

  "contraste": {
    "meta": "WCAG 2.2 AA: texto normal ≥ 4.5:1; texto grande (≥24px, ou ≥18.66px negrito) ≥ 3:1; componentes de UI, ícones informativos e anel de foco ≥ 3:1 (1.4.11). Razões calculadas pela fórmula de luminância relativa do WCAG.",
    "regras": [
      "Nunca transmitir estado só por cor: acompanhar de ícone + texto (erro, sucesso, obrigatório).",
      "Texto desabilitado é isento de contraste, mas deve continuar legível (use neutral.muted com opacidade ≥ .6 e aria-disabled).",
      "Tamanho mínimo de alvo de toque: 44×44 (ver size.target); mínimo normativo AA é 24×24 (WCAG 2.5.8).",
      "Placeholder não substitui rótulo; usar neutral.muted."
    ],
    "pares": [
      { "fg": "neutral.text",    "bg": "neutral.bg",       "razao": 14.07, "uso": "Corpo de texto",                 "ok": "AAA" },
      { "fg": "neutral.text",    "bg": "neutral.surface",  "razao": 13.09, "uso": "Texto em cartão",                "ok": "AAA" },
      { "fg": "brand.navy",      "bg": "neutral.bg",       "razao": 14.27, "uso": "Títulos",                        "ok": "AAA" },
      { "fg": "neutral.muted",   "bg": "neutral.bg",       "razao": 6.14,  "uso": "Texto secundário",               "ok": "AA" },
      { "fg": "neutral.muted",   "bg": "neutral.surface",  "razao": 5.71,  "uso": "Texto secundário em cartão",     "ok": "AA" },
      { "fg": "neutral.muted",   "bg": "primary.tint",     "razao": 5.44,  "uso": "Texto secundário em item selecionado", "ok": "AA" },
      { "fg": "brand.blue",      "bg": "neutral.bg",       "razao": 7.01,  "uso": "Links, texto de ação",           "ok": "AAA" },
      { "fg": "brand.blue",      "bg": "neutral.surface",  "razao": 6.52,  "uso": "Links em cartão",                "ok": "AA" },
      { "fg": "neutral.white",   "bg": "primary.default",  "razao": 7.01,  "uso": "Botão primário",                 "ok": "AAA" },
      { "fg": "neutral.white",   "bg": "brand.navy",       "razao": 14.27, "uso": "Cabeçalho escuro",               "ok": "AAA" },
      { "fg": "brand.navy",      "bg": "accent.default",   "razao": 7.87,  "uso": "Botão de destaque / selo",       "ok": "AAA" },
      { "fg": "brand.navy",      "bg": "accent.light",     "razao": 10.1,  "uso": "Selo de conquista",              "ok": "AAA" },
      { "fg": "feedback.success.fg", "bg": "feedback.success.bg", "razao": 5.77, "uso": "Alerta de sucesso",       "ok": "AA" },
      { "fg": "feedback.error.fg",   "bg": "feedback.error.bg",   "razao": 6.84, "uso": "Alerta/mensagem de erro", "ok": "AA" },
      { "fg": "feedback.warning.fg", "bg": "feedback.warning.bg", "razao": 6.61, "uso": "Alerta de aviso",         "ok": "AA" },
      { "fg": "feedback.info.fg",    "bg": "feedback.info.bg",    "razao": 6.21, "uso": "Alerta informativo",      "ok": "AA" },
      { "fg": "feedback.error.solid","bg": "neutral.bg",          "razao": 6.54, "uso": "Texto de erro direto no fundo / borda de campo inválido", "ok": "AA" },
      { "fg": "feedback.success.solid", "bg": "neutral.bg",       "razao": 5.34, "uso": "Ícone/texto de sucesso",   "ok": "AA" },
      { "fg": "neutral.border",  "bg": "neutral.bg",       "razao": 3.51,  "uso": "Borda de campo (não-texto)",     "ok": "AA 1.4.11" },
      { "fg": "neutral.border",  "bg": "neutral.surface",  "razao": 3.27,  "uso": "Borda de campo em cartão",       "ok": "AA 1.4.11" },
      { "fg": "focus.ring",      "bg": "neutral.bg",       "razao": 7.01,  "uso": "Anel de foco claro",             "ok": "AAA" },
      { "fg": "focus.ringOnDark","bg": "brand.navy",       "razao": 7.87,  "uso": "Anel de foco sobre navy",        "ok": "AAA" }
    ],
    "proibidos": [
      { "fg": "brand.yellow",   "bg": "neutral.bg",    "razao": 1.81, "motivo": "Amarelo como texto/ícone/borda sobre branco." },
      { "fg": "brand.blue",     "bg": "brand.navy",    "razao": 2.04, "motivo": "Azul sobre navy; use branco ou amarelo." },
      { "fg": "neutral.line",   "bg": "neutral.bg",    "razao": 1.2,  "motivo": "Borda de campo; use neutral.border." },
      { "fg": "#9aa8bd",        "bg": "neutral.bg",    "razao": 2.41, "motivo": "Cinza claro de 'desabilitado' como texto informativo." }
    ]
  },

  "typography": {
    "family": {
      "sans": { "value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif", "origem": "body em style.css" },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "uso": "Códigos e usuário/PIN, se necessário." }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 650, "bold": 800, "black": 900, "nota": "900 só para o logotipo (como em style.css)." },
    "size": {
      "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 20,
      "h4": 20, "h3": 24, "h2": 30, "h1": 38, "display": 48,
      "nota": "Texto corrido nunca abaixo de 16px (14px só para legendas/ajuda)."
    },
    "lineHeight": { "tight": 1.2, "snug": 1.35, "normal": 1.5, "relaxed": 1.7, "nota": "WCAG 1.4.12 deve funcionar com line-height 1.5 e espaçamentos ampliados." },
    "letterSpacing": { "normal": 0, "caps": 0.04 },
    "measure": { "max": "65ch", "uso": "Largura máxima de parágrafos." },
    "responsive": {
      "h1": { "mobile": 28, "desktop": 38 },
      "h2": { "mobile": 24, "desktop": 30 },
      "display": { "mobile": 36, "desktop": 48 }
    }
  },

  "space": {
    "base": 4,
    "scale": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
    "gutter": { "mobile": 16, "desktop": 24 },
    "container": { "max": 1380, "width": "min(1380px, 92%)", "origem": ".container em style.css", "formMax": 440, "contentMax": 1100 }
  },

  "radius": {
    "sm": 6, "md": 12, "lg": 16, "xl": 24, "pill": 999,
    "origem": "md = .btn (12px) em style.css",
    "uso": { "campo": "md", "botao": "md", "cartao": "lg", "modal": "lg", "selo": "pill" }
  },

  "shadow": {
    "sm": "0 1px 2px rgba(6, 43, 81, 0.08)",
    "md": "0 4px 12px rgba(6, 43, 81, 0.10)",
    "lg": "0 12px 32px rgba(6, 43, 81, 0.14)",
    "uso": { "cartao": "sm", "menu": "md", "modal": "lg" },
    "regra": "Sombra nunca é o único indicador de limite ou estado."
  },

  "border": { "width": { "thin": 1, "default": 2 }, "campo": "2px solid neutral.border", "campoErro": "2px solid feedback.error.solid" },

  "size": {
    "target": { "min": 44, "fundI": 48, "aaMin": 24, "nota": "Alvo de toque/clique ≥ 44px (48 no Fund. I); AA exige 24px (WCAG 2.5.8)." },
    "control": { "sm": 36, "md": 44, "lg": 52 },
    "icon": { "sm": 16, "md": 20, "lg": 24, "xl": 32 },
    "header": 74
  },

  "breakpoints": {
    "abordagem": "mobile-first: estilos base = 360px; usar min-width para ampliar.",
    "xs": 0,
    "sm": 480,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "layout": {
      "sm": "1 coluna, gutter 16",
      "md": "2 colunas em grades de cartões; formulários continuam 1 coluna (max 440)",
      "lg": "navegação lateral/topo completa; grades de 3 colunas",
      "xl": "container até 1380"
    },
    "legado": "style.css usa max-width 1150/900/620/430; a plataforma nova usa os breakpoints acima."
  },

  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "regra": "Respeitar prefers-reduced-motion: reduce (sem animação de movimento, sem confete; manter só mudanças de cor/opacidade). Nada pisca mais de 3 vezes por segundo."
  },

  "zIndex": { "header": 50, "dropdown": 60, "modal": 100, "toast": 110 },

  "etapa": {
    "descricao": "Variações por etapa de ensino (definida pelo ano escolar no cadastro). FE aplica via atributo data-etapa no elemento raiz da área logada; telas públicas usam 'neutra'.",
    "fund1":  { "rotulo": "Fundamental I (1º–5º ano)",   "fontBase": 18, "target": 48, "densidade": "ampla",   "icones": "grandes, com rótulo sempre visível", "raioExtra": 4 },
    "fund2":  { "rotulo": "Fundamental II (6º–9º ano)",  "fontBase": 16, "target": 44, "densidade": "padrão",  "icones": "médios, rótulo visível", "raioExtra": 0 },
    "medio":  { "rotulo": "Ensino Médio (1ª–3ª série)",  "fontBase": 16, "target": 44, "densidade": "padrão",  "icones": "médios", "raioExtra": 0 },
    "neutra": { "rotulo": "Telas públicas e professor",  "fontBase": 16, "target": 44, "densidade": "padrão",  "icones": "médios", "raioExtra": 0 }
  }
}
