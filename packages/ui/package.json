{
  "name": "@aprendemais/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Componentes React e tokens CSS (--am-*). Consumido direto do código-fonte.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "node scripts/gerar-tokens.mjs",
    "tokens:check": "node scripts/gerar-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "playground": "vite --open /playground/",
    "build": "node scripts/gerar-tokens.mjs --check && tsc --noEmit && vite build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest-axe": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jest-axe": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
